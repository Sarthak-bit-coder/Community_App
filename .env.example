# Copy this file to .env and fill in what you need. Everything is optional:
# anything left blank falls back to a free mode or is logged to the console.

SECRET_KEY=change-me-to-a-long-random-string
# Public address of the app (needed for WhatsApp webhooks and links in SMS/WhatsApp alerts),
# e.g. your ngrok URL: https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# ---- AI (reads WhatsApp messages + news) ----------------------------------------
# auto = Claude if ANTHROPIC_API_KEY is set, else Ollama if it's running, else keyword rules.
AI_ENGINE=auto
# FREE option: install Ollama (https://ollama.com/download), then run:  ollama pull qwen2.5:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Paid but cheap option: https://console.anthropic.com/ -> API keys (Claude Haiku 5.5, ~$0.10 per 1M input tokens)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---- Local news -------------------------------------------------------------------
# Google News RSS is always on (free, no key).
# Comma-separated RSS feeds from local outlets (free):
NEWS_RSS_FEEDS=
# https://newsapi.org/register  (free developer plan: 100 requests/day, articles delayed 24h)
NEWSAPI_KEY=
# How often to check (minutes; 0 turns automatic checks off) and when to clear stale news incidents
NEWS_POLL_MINUTES=30
NEWS_EXPIRE_HOURS=48

# ---- Email (Gmail: use an App Password, not your normal password) ---------------------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ---- Twilio: SMS + WhatsApp alerts, and the WhatsApp AI bot ----------------------------
# https://www.twilio.com/try-twilio  (free trial credit)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number for SMS, in E.164 format, e.g. +15551234567
TWILIO_SMS_FROM=
# Your Twilio WhatsApp sender. For the free sandbox this is +14155238886
TWILIO_WHATSAPP_FROM=
