# Copy this file to .env and fill in what you need. Every channel is optional:
# anything left blank is logged to the console instead of being sent.

SECRET_KEY=change-me-to-a-long-random-string

# Email (Gmail: use an App Password, not your normal password)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Twilio (SMS + WhatsApp) — https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number for SMS, in E.164 format, e.g. +15551234567
TWILIO_SMS_FROM=
# Your Twilio WhatsApp sender. For the free sandbox this is +14155238886
TWILIO_WHATSAPP_FROM=
